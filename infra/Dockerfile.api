# syntax=docker/dockerfile:1

############ Stage 1: Builder ############
FROM php:8.5-fpm-alpine AS builder

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_NO_INTERACTION=1

RUN apk add --no-cache \
    composer \
    git \
    curl \
    unzip \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    libwebp-dev \
    freetype-dev

RUN docker-php-ext-configure gd \
      --with-freetype \
      --with-jpeg \
      --with-webp \
    && docker-php-ext-install -j"$(nproc)" \
      pdo_mysql \
      zip \
      gd \
      bcmath \
      pcntl \
      posix

WORKDIR /app

# Salin seluruh source agar skrip composer (artisan package:discover) bisa berjalan
COPY apps/api/ .

RUN mkdir -p bootstrap/cache storage/framework/cache storage/framework/sessions storage/framework/views storage/logs \
    && composer install \
      --no-interaction \
      --no-progress \
      --prefer-dist \
      --optimize-autoloader

############ Stage 2: Runtime ############
FROM php:8.5-fpm-alpine

RUN apk add --no-cache \
    nginx \
    curl \
    libzip \
    libpng \
    libjpeg-turbo \
    libwebp \
    freetype

RUN docker-php-ext-configure gd \
      --with-freetype \
      --with-jpeg \
      --with-webp \
    && docker-php-ext-install -j"$(nproc)" \
      pdo_mysql \
      zip \
      gd \
      bcmath \
      pcntl \
      posix \
      opcache

# Tunning PHP untuk import Excel / payload besar
RUN printf 'upload_max_filesize=100M\npost_max_size=120M\nmemory_limit=512M\n' \
    > /usr/local/etc/php/conf.d/stitchra.ini

WORKDIR /app

COPY apps/api/ .
COPY --from=builder /app/vendor ./vendor

RUN mkdir -p storage/logs storage/framework/cache storage/framework/sessions storage/framework/views bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY infra/nginx/api.conf /etc/nginx/conf.d/default.conf
COPY infra/startup-api.sh /startup.sh
RUN chmod +x /startup.sh

EXPOSE 80 9000

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=5 \
    CMD curl -f http://localhost/up || exit 1

CMD ["/startup.sh"]