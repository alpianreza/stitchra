# syntax=docker/dockerfile:1

############ Stage 1: Builder ############
FROM php:8.4-fpm-alpine AS builder

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_NO_INTERACTION=1

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN apk add --no-cache \
    git \
    curl \
    unzip \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    libwebp-dev \
    freetype-dev

RUN docker-php-ext-configure gd \
      --with-freetype \
      --with-jpeg \
      --with-webp \
    && docker-php-ext-install -j"$(nproc)" \
      pdo_mysql \
      zip \
      gd \
      bcmath \
      pcntl \
      posix

# phpredis (ekstensi Redis asli; runtime memakai predis via compose, ini jaring pengaman)
RUN apk add --no-cache --virtual .phpize-deps $PHPIZE_DEPS \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .phpize-deps

WORKDIR /app

# Salin seluruh source agar skrip composer (artisan package:discover) bisa berjalan
COPY apps/api/ .

RUN --mount=type=cache,target=/root/.composer/cache \
    mkdir -p bootstrap/cache storage/framework/cache storage/framework/sessions storage/framework/views storage/logs \
    && composer install \
      --no-interaction \
      --no-progress \
      --prefer-dist \
      --optimize-autoloader

############ Stage 2: Runtime ############
FROM php:8.4-fpm-alpine

RUN apk add --no-cache \
    nginx \
    curl \
    libzip \
    libpng \
    libjpeg-turbo \
    libwebp \
    freetype

# Ekstensi PHP sudah dikompilasi di stage builder (dengan -dev headers);
# salin artefak .so ke runtime dan aktifkan, tanpa kompilasi ulang.
COPY --from=builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
RUN docker-php-ext-enable gd zip pdo_mysql bcmath pcntl posix redis

# Tunning PHP untuk import Excel / payload besar
RUN printf 'upload_max_filesize=100M\npost_max_size=120M\nmemory_limit=512M\n' \
    > /usr/local/etc/php/conf.d/stitchra.ini

WORKDIR /app

COPY apps/api/ .
COPY --from=builder /app/vendor ./vendor

RUN mkdir -p storage/logs storage/framework/cache storage/framework/sessions storage/framework/views bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY infra/nginx/api.conf /etc/nginx/http.d/default.conf
COPY infra/startup-api.sh /startup.sh
RUN chmod +x /startup.sh

EXPOSE 80 9000

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=5 \
    CMD curl -f http://localhost/up || exit 1

CMD ["/startup.sh"]
