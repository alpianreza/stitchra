APP_NAME=Stitchra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=stitchra
DB_USERNAME=stitchra
DB_PASSWORD=secret

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=redis
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=stitchra
REVERB_APP_KEY=stitchra-key
REVERB_APP_SECRET=stitchra-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=stitchra
AWS_SECRET_ACCESS_KEY=stitchra_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=stitchra
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_TOKEN_EXPIRATION=480
SANCTUM_TOKEN_PREFIX=stitchra_
FRONTEND_URL=http://localhost

TELESCOPE_ENABLED=false
