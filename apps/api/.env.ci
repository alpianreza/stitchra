# Environment khusus CI (GitHub Actions) — non-secret, aman di-commit (BR-113)
APP_NAME=Stitchra
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stitchra_test
DB_USERNAME=root
DB_PASSWORD=root_secret

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=local
TELESCOPE_ENABLED=false
